# Contract: https://doppiai.uz/api/docs (raw spec: /api/openapi.json).
# Same-origin API keeps the HttpOnly session cookie on the public origin.
VITE_API_BASE_URL=/api/v1

# Google authorization is a top-level navigation; OAuth state and PKCE stay backend-owned.
VITE_GOOGLE_OAUTH_URL=/api/v1/auth/oauth/google/authorize

# Email OTP is enabled after production SMTP delivery is accepted.
VITE_EMAIL_AUTH_ENABLED=false

# Telegram remains disabled until the complete account-link release is accepted.
VITE_TELEGRAM_AUTH_ENABLED=false
VITE_TELEGRAM_BOT_USERNAME=

# Live voice agent behind the Hero orb. The base URL is a temporary Cloudflare
# tunnel that changes on every restart — get the current one and set it here
# rather than shipping the default baked into src/shared/config/voiceAgent.ts.
# Use the public `ui` key only; never the `admin` key. See UI_INTEGRATION_GUIDE.md.
VITE_VOICE_AGENT_BASE_URL=https://visits-sessions-sri-abc.trycloudflare.com
VITE_VOICE_AGENT_API_KEY=
